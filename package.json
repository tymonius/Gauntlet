{
  "name": "gauntlet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "governance:check": "python .github/scripts/validate-governance.py && python .github/scripts/validate-conversation-audit.py && python .github/scripts/validate-live-tail.py",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:full": "npm run typecheck && npm run test && npm run test:current-contract && npm run test:deckbuilder && npm run analytics:check",
    "test:current-contract": "node scripts/validate-current-public-contract.mjs",
    "test:v062-shared-rules": "node scripts/validate-v062-shared-rules.mjs",
    "test:v062-faction-components": "node scripts/validate-v062-faction-components.mjs",
    "test:v062-starters-onboarding": "node scripts/validate-v062-starters-onboarding.mjs",
    "test:v062-live": "node scripts/validate-v062-live-propagation.mjs",
    "test:v062-arbiter-digital": "node scripts/validate-v062-arbiter-digital.mjs",
    "test:v062-card-execution": "node scripts/validate-v062-card-execution.mjs",
    "test:v062-release-closeout": "node scripts/validate-v062-release-closeout.mjs",
    "test:v062-site": "node scripts/synchronize-v062-public-site.mjs --check",
    "test:v062-published": "node scripts/validate-v062-published-release.mjs",
    "release:v062:build": "node scripts/assert-release-writable.mjs v0.6.2 && node scripts/build-v062-release-runner.mjs && node scripts/synchronize-v062-public-site.mjs && node scripts/synchronize-v062-print-release.mjs",
    "release:v062:check": "node scripts/check-v062-release-lifecycle.mjs",
    "print:v062:html": "node scripts/assert-release-writable.mjs v0.6.2 && node scripts/build-v062-print-html.mjs",
    "print:v062:html:check": "node scripts/build-v062-print-html.mjs --check",
    "print:v062:sync": "node scripts/assert-release-writable.mjs v0.6.2 && node scripts/synchronize-v062-print-release.mjs",
    "print:v062:sync:check": "node scripts/synchronize-v062-print-release.mjs --check",
    "print:v062:render": "node scripts/assert-release-writable.mjs v0.6.2 && node scripts/render-v062-print-package.mjs",
    "print:v062:validate": "node scripts/validate-v062-print-package.mjs",
    "print:v062:build": "npm run print:v062:render && npm run print:v062:sync && npm run print:v062:validate",
    "print:v062:check": "npm run print:v062:html:check && npm run print:v062:sync:check && npm run print:v062:validate",
    "data:v062": "node scripts/generate-v062-canonical-data.mjs",
    "data:v062:write": "node scripts/generate-v062-canonical-data.mjs --write",
    "test:rules-assistant": "vitest run rules-assistant/*.test.mjs",
    "test:playtest-sessions": "vitest run workers/playtest-sessions/src/*.test.mjs",
    "test:formal-session-e2e": "node --experimental-sqlite scripts/test_v063_formal_session_e2e.mjs",
    "test:tracked-session-e2e": "node --experimental-sqlite scripts/test_tracked_playtest_e2e.mjs",
    "test:deckbuilder": "node scripts/validate-starter-decks.mjs",
    "analytics:sync": "node scripts/sync-google-analytics.mjs",
    "analytics:check": "node scripts/sync-google-analytics.mjs --check",
    "tts:components:check": "node scripts/tts-component-contract.mjs",
    "tts:supplementals:check": "node scripts/generate-tts-supplemental-assets.mjs --check",
    "tts:finalized-supplementals:check": "node scripts/generate-tts-finalized-supplementals.mjs --check",
    "tts:check": "npm run tts:components:check && npm run tts:supplementals:check && npm run tts:finalized-supplementals:check && node scripts/generate-tts-card-assets.mjs --check && node scripts/generate-tts-territory-assets.mjs --check && node scripts/generate-tts-leader-assets.mjs --check && node scripts/generate-tts-starter-decks.mjs --check && node scripts/generate-tts-save.mjs --check && node tts/apply-table-layout.mjs --check && node scripts/assemble-tts-supplemental-save.mjs --check && node --check scripts/tts-supplemental-geometry.mjs && node --check tts/ensure-current-mystics-assets.mjs && node --check scripts/promote-tts-save.mjs",
    "tts:catalog": "node scripts/generate-tts-card-assets.mjs --catalog-only",
    "tts:cards": "node scripts/generate-tts-card-assets.mjs",
    "tts:territories": "node scripts/generate-tts-territory-assets.mjs",
    "tts:leaders": "node scripts/generate-tts-leader-assets.mjs",
    "tts:starters": "node scripts/generate-tts-starter-decks.mjs",
    "tts:supplementals": "node scripts/generate-tts-supplemental-assets.mjs",
    "tts:finalized-supplementals": "node scripts/generate-tts-finalized-supplementals.mjs",
    "tts:release:stage": "node tts/ensure-current-mystics-assets.mjs && npm run tts:environment && node scripts/stage-tts-release-assets.mjs",
    "tts:release:status": "node scripts/check-tts-release-readiness.mjs",
    "tts:release:strict": "node scripts/check-tts-release-readiness.mjs --strict",
    "tts:save:base": "node scripts/generate-tts-save.mjs",
    "tts:save:layout": "node tts/apply-table-layout.mjs",
    "tts:save": "npm run tts:save:base && npm run tts:save:layout",
    "tts:save:assemble": "node scripts/assemble-tts-supplemental-save.mjs",
    "tts:save:promote": "node scripts/promote-tts-save.mjs",
    "tts:build": "npm run tts:components:check && npm run tts:cards && npm run tts:territories && npm run tts:leaders && npm run tts:starters",
    "tts:package": "npm run tts:build && npm run tts:supplementals && npm run tts:finalized-supplementals && npm run tts:release:stage && npm run tts:save && npm run tts:save:assemble && node tts/validate-current-authoritative-save.mjs && npm run tts:release:status",
    "preview:v063:cards": "node scripts/generate-v063-production-card-preview.mjs",
    "media:check": "node scripts/generate-card-media-assets.mjs --check && node scripts/generate-card-media-compositions.mjs --check",
    "media:build": "node scripts/generate-card-media-library.mjs",
    "test:watch": "vitest",
    "dev:cli": "tsx src/cli/dev-runner-v06.ts",
    "dev:gui": "tsx src/gui/dev-server-v06.ts",
    "tts:environment": "node scripts/generate-tts-environment-assets.mjs",
    "release:v070:finalize": "node scripts/finalize-v070-publication.mjs",
    "rules:facts:check": "node scripts/sync-current-rulebook-facts.mjs",
    "rules:facts:sync": "node scripts/sync-current-rulebook-facts.mjs --write"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright": "^1.62.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "sharp": "^0.33.5"
  }
}
