# Copy to .env. Never commit the real .env file.

# Database and initial administrator
POSTGRES_USER=listmonk
POSTGRES_DB=listmonk
POSTGRES_PASSWORD=replace-with-a-long-random-password
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=replace-with-a-different-long-random-password

# Local bind only. A production reverse proxy should publish HTTPS.
LISTMONK_PORT=9000
TZ=America/New_York

# Planned production identity. These values are documentation for setup;
# listmonk SMTP settings are entered in its Admin UI after first launch.
NEWSLETTER_PUBLIC_URL=https://newsletter.gauntlet.run
NEWSLETTER_FROM_NAME=Gauntlet
NEWSLETTER_FROM_EMAIL=updates@gauntlet.run
AWS_REGION=us-east-1
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USERNAME=replace-after-creating-region-specific-smtp-credentials
SES_SMTP_PASSWORD=replace-after-creating-region-specific-smtp-credentials
