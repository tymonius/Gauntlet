{
  "schemaVersion": 1,
  "authoritySource": "game-data/current-game.json",
  "principles": {
    "singleAuthority": "current-game.json is the only gameplay authority; rules surfaces are projections or reviewed explanations of it.",
    "technicalCorpus": "The Comprehensive Gauntlet Rules are the single complete technical rules corpus for core and faction rules.",
    "teachingSurfaces": "The Player's Guide and Faction Guides may simplify wording but may not change mechanics.",
    "referenceCards": "Reference cards are compact procedural projections, not independent rule authorities.",
    "arbiter": "The Rules Arbiter resolves from technical authority and canonical game objects, then answers in player-friendly language."
  },
  "dependencyModes": {
    "direct": "Mechanical copy is rendered or assembled directly from registered authority rules.",
    "reviewedTeaching": "Human-authored copy declares registered rule dependencies and must be re-reviewed when those dependencies change.",
    "procedural": "Compact at-table copy is derived from authority; bespoke phrasing must retain declared dependencies."
  },
