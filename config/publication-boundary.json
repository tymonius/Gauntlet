{
  "schemaVersion": 1,
  "purpose": "Defines the intentional Gauntlet public-route graph and GitHub Pages publication boundary independently from repository source layout.",
  "pages": {
    "publishedDirectories": [
      "about",
      "accessibility",
      "assets",
      "card-design",
      "changelog",
      "config",
      "contact",
      "faq",
      "images",
      "press",
      "privacy",
      "releases",
      "rulebook",
      "rules-arbiter",
      "rules-assistant",
      "tts",
      "v0.7.1"
    ],
    "rootFiles": {
      "required": ["404.html", "CNAME", "index.html"],
      "allowedExtensions": [
        ".css",
        ".js",
        ".ico",
        ".png",
        ".svg",
        ".webp",
        ".jpg",
        ".jpeg",
        ".webmanifest",
        ".xml",
        ".txt"
      ],
      "generated": [".nojekyll"]
    },
    "sourceOnlyRepositoryRoots": [
      ".github",
      "apps",
      "artifacts",
      "docs",
      "governance",
      "legacy",
      "media",
      "packages",
      "rulebook-design",
      "rulebook-production",
      "scripts",
      "src",
      "tests",
      "workers"
    ]
  },
  "materializedRoutes": [
    {"source": "apps/card-reference", "publicPath": "/card-reference/", "kind": "current-app", "manageIndexRoutes": true},
    {"source": "apps/deckbuilder", "publicPath": "/deckbuilder/", "kind": "current-app", "manageIndexRoutes": true},
    {"source": "apps/factions", "publicPath": "/factions/", "kind": "current-app", "manageIndexRoutes": true},
    {"source": "apps/rules", "publicPath": "/rules/", "kind": "current-app", "manageIndexRoutes": true},
    {"source": "apps/start", "publicPath": "/start/", "kind": "current-app", "manageIndexRoutes": true},
    {"source": "apps/playtest", "publicPath": "/playtest/", "kind": "current-app", "manageIndexRoutes": true},
    {"source": "packages/game-data", "publicPath": "/game-data/", "kind": "shared-browser-contract", "manageIndexRoutes": false},
    {"source": "legacy/public-versions/v0.6.2", "publicPath": "/v0.6.2/", "kind": "historical-version", "manageIndexRoutes": false},
    {"source": "legacy/public-versions/v0.6.3", "publicPath": "/v0.6.3/", "kind": "historical-version", "manageIndexRoutes": false},
    {"source": "legacy/public-versions/v0.7.0", "publicPath": "/v0.7.0/", "kind": "historical-version", "manageIndexRoutes": false},
    {"source": "legacy/public-compatibility/deckbuilder-v0.5", "publicPath": "/deckbuilder-v0.5/", "kind": "retired-compatibility", "manageIndexRoutes": false},
    {"source": "legacy/public-compatibility/deckbuilder-v0.6", "publicPath": "/deckbuilder-v0.6/", "kind": "retired-compatibility", "manageIndexRoutes": false},
    {"source": "legacy/public-compatibility/faction-sheets", "publicPath": "/faction-sheets/", "kind": "retired-compatibility", "manageIndexRoutes": false}
  ],
  "materializedFiles": [
    {"source": "images/sketches/hero-sketches/hero sketch.png", "publicPath": "/images/sketches/hero sketch.png", "kind": "retired-compatibility"}
  ],
  "managedRoutes": [
    "/card-reference/",
    "/deckbuilder/",
    "/factions/",
    "/factions/diplomats/",
    "/factions/financiers/",
    "/factions/inquisition/",
    "/factions/intelligence/",
    "/factions/military/",
    "/factions/mystics/",
    "/rules/",
    "/rules/factions/",
    "/rules/factions/diplomats/",
    "/rules/factions/financiers/",
    "/rules/factions/inquisition/",
    "/rules/factions/intelligence/",
    "/rules/factions/military/",
    "/rules/factions/mystics/",
    "/start/",
    "/playtest/",
    "/playtest/analysis/",
    "/playtest/analysis/integrity/",
    "/playtest/batch/",
    "/playtest/feedback/",
    "/playtest/guide/",
    "/playtest/host/",
    "/playtest/onboarding/",
    "/playtest/player-mat/",
    "/playtest/retrospective/",
    "/playtest/session/",
    "/playtest/sheet/",
    "/playtest/tracked/"
  ],
  "versionedRoutes": [
    {"version": "v0.6.2", "publicPath": "/v0.6.2/", "source": "legacy/public-versions/v0.6.2"},
    {"version": "v0.6.3", "publicPath": "/v0.6.3/", "source": "legacy/public-versions/v0.6.3"},
    {"version": "v0.7.0", "publicPath": "/v0.7.0/", "source": "legacy/public-versions/v0.7.0"},
    {"version": "v0.7.1", "publicPath": "/v0.7.1/", "source": "v0.7.1"}
  ]
}
